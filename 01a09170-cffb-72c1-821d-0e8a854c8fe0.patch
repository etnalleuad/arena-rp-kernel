+#!/usr/bin/env python3 """Build a registry of official IMPROCOM vlog/backstage videos.""" from __future__ import annotations import csv import json from pathlib import Path ROOT = Path(__file__).resolve().parents[1] CATALOG = ROOT / "corpus" / "show_catalog" / "improcom_youtube_catalog.json" OUT = ROOT / "corpus" / "vlog_backstage" EXACT_OVERRIDES = { "Ni1Ro8WwihA": "2019-11-14", "f4ud2Nmk9pA": "2020-01-31", } PILOT = { "Ni1Ro8WwihA": ["DOMESTIC_PROXY", "PACKING", "HOME_VISIT", "SHOW_CLOTHES"], "f4ud2Nmk9pA": ["TRAVEL", "FATIGUE", "SHOPPING", "COLD", "HOTEL"], "DmSyP9uDmkU": ["TRAVEL", "LONG_FLIGHT", "FOOD", "GROUP_HELP"], "novGWE-zYDo": ["PROFESSIONAL_BACKSTAGE", "SHOW_CREATION"], "cQmWhFmWdHQ": ["CURRENT_TRAVEL", "SHOPPING", "COLLECTING", "ILLNESS", "GIFTS"], "BEwsvJa8ctE": ["CURRENT_BACKSTAGE", "REHEARSAL", "STRESS", "RESPONSIBILITY"], } def classify(title: str) -> list[str]: t = title.lower() tags = [] if any(x in t for x in ["тур", "гастрол", "дальний восток", "беларус"]): tags.append("TRAVEL") if any(x in t for x in ["съём", "сезон", "студия союз", "как создавалось"]): tags.append("BACKSTAGE") if "вечерин" in t: tags.extend(["EVENT", "REHEARSAL_PERFORMANCE"]) if "короткометраж" in t: tags.append("FICTIONAL_SHORT_NOT_DOMESTIC_EVIDENCE") if not tags: tags.append("MIXED_VLOG") return tags def hms(seconds: int) -> str: h, rem = divmod(seconds, 3600) m, s = divmod(rem, 60) return f"{h:02d}:{m:02d}:{s:02d}" def main() -> None: catalog = json.loads(CATALOG.read_text()) rows = [] for e in catalog["entries"]: if "ВЛОГ" not in e["format"]: continue vid = e["video_id"] rows.append( { "video_id": vid, "title": e["title"], "url": e["url"], "catalog_upload_date": e["upload_date"], "verified_upload_date": EXACT_OVERRIDES.get(vid), "date_status": "PAGE_VERIFIED" if vid in EXACT_OVERRIDES else e["date_precision"], "duration_seconds": e["duration_seconds"], "duration_hms": e["duration_hms"], "format_tags": classify(e["title"]), "pilot_selected": vid in PILOT, "pilot_tags": PILOT.get(vid, []), "speaker_clean_status": "NOT_STARTED", "naturalness": "N1_N2_EDITED_CAMERA_AWARE", "warning": "Actions can be selected, prompted or edited; stage/performance segments require separate coding.", } ) rows.sort(key=lambda r: (r["verified_upload_date"] or r["catalog_upload_date"], r["video_id"])) OUT.mkdir(parents=True, exist_ok=True) total = sum(r["duration_seconds"] for r in rows) pilot_total = sum(r["duration_seconds"] for r in rows if r["pilot_selected"]) payload = { "status": "OFFICIAL_VLOG_REGISTRY_V0_1", "created": "2026-08-16", "video_count": len(rows), "total_duration_seconds": total, "total_duration_hms": hms(total), "pilot_video_count": sum(r["pilot_selected"] for r in rows), "pilot_duration_seconds": pilot_total, "pilot_duration_hms": hms(pilot_total), "warning": "Several old catalog dates are only approximate migration/index dates. Exact original upload dates need page verification.", "videos": rows, } (OUT / "vlog_backstage_registry.json").write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n") with (OUT / "vlog_backstage_registry.csv").open("w", newline="") as fh: w = csv.DictWriter(fh, fieldnames=list(rows[0])) w.writeheader() w.writerows(rows) lines = [ "# VLOG / BACKSTAGE REGISTRY", "", f"> {len(rows)} official videos; {hms(total)} total. Pilot: {sum(r['pilot_selected'] for r in rows)} videos / {hms(pilot_total)}.", "", "| ID | Date | Duration | Pilot | Tags | Title |", "|---|---:|---:|---:|---|---|", ] for r in rows: date = r["verified_upload_date"] or r["catalog_upload_date"] tags = ", ".join(r["pilot_tags"] or r["format_tags"]) lines.append(f"| `{r['video_id']}` | {date} | {r['duration_hms']} | {'yes' if r['pilot_selected'] else ''} | {tags} | {r['title']} |") (OUT / "vlog_backstage_registry.md").write_text("\n".join(lines) + "\n") print(json.dumps({k: payload[k] for k in ["video_count", "total_duration_hms", "pilot_video_count", "pilot_duration_hms"]}, ensure_ascii=False, indent=2)) if __name__ == "__main__": main() 
