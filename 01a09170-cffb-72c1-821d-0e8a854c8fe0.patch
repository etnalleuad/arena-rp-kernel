+#!/usr/bin/env python3 """Print timestamped windows from AUTO_TRANSCRIPT_UNVERIFIED JSON files.""" from __future__ import annotations import argparse, json from pathlib import Path ROOT = Path(__file__).resolve().parents[1] TRANSCRIPTS = ROOT / "corpus" / "transcripts_auto" def parse_time(value: str) -> float: parts = [float(x) for x in value.split(":")] if len(parts) == 3: return parts[0] * 3600 + parts[1] * 60 + parts[2] if len(parts) == 2: return parts[0] * 60 + parts[1] return parts[0] def stamp(seconds: float) -> str: total = int(seconds) h, rem = divmod(total, 3600) m, s = divmod(rem, 60) return f"{h:02d}:{m:02d}:{s:02d}" ap = argparse.ArgumentParser() ap.add_argument("source_id") ap.add_argument("times", nargs="*") ap.add_argument("--before", type=float, default=10) ap.add_argument("--after", type=float, default=60) ap.add_argument("--keyword", action="append", default=[]) ap.add_argument("--limit", type=int, default=10) args = ap.parse_args() payload = json.loads((TRANSCRIPTS / f"{args.source_id}.json").read_text(encoding="utf-8")) rows = payload["segments"] windows = [] for t in args.times: center = parse_time(t) windows.append((center - args.before, center + args.after, t)) for kw in args.keyword: hits = [r for r in rows if kw.casefold() in r["text"].casefold()][:args.limit] for n, hit in enumerate(hits, 1): windows.append((hit["start"] - args.before, hit["start"] + args.after, f"{kw}#{n}")) for start, end, label in windows: print(f"\n## {args.source_id} — {label} ({stamp(max(0,start))}–{stamp(end)})") selected = [r for r in rows if start <= r["start"] <= end] for r in selected: print(f"[{stamp(r['start'])}] {r['text']}") 
